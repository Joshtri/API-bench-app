{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API Bench",
  "version": "0.1.2",
  "identifier": "com.yosry.api-benchmark-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "API Bench",
        "width": 1360,
        "height": 900,
        "minWidth": 480,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0B0C0E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOTkzNzlFRjRFOThFQTkKUldTcGp1bjBuamVaVXhNNWd3aW1wQkVxT3h2Vkcza0FqR3ZsazM2ZTROMlRJcFYyeDV0OW15UXIK",
      "endpoints": [
        "https://github.com/Joshtri/API-bench-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
